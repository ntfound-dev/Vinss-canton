# Public configuration; never put ledger tokens or wallet secrets here.
NEXT_PUBLIC_CANTON_NETWORK=devnet
# Exact networkId returned by your wallet when it differs from devnet/testnet/mainnet.
# NEXT_PUBLIC_CANTON_WALLET_NETWORK_ID=devnet
# Hosted CIP-103 RPC gateway. An origin gets /api/v0/dapp appended;
# an explicit path is used unchanged. Do not use a validator Ledger API URL.
# DevNet: Send Connect and Grofty cannot replace this gateway. Obtain the CIP-103
# RPC URL from the operator; the NODERS web wallet is not itself this endpoint.
# NEXT_PUBLIC_CANTON_WALLET_GATEWAY_URL=https://your-wallet-gateway.example/api/v0/dapp
# NEXT_PUBLIC_CANTON_WALLET_GATEWAY_NAME=Your Canton Gateway
# Optional WalletConnect project. Allowlist the application origin in its dashboard.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-public-project-id
# CC only: obtain this network's DSO party, never reuse another network's admin.
# NEXT_PUBLIC_CANTON_CC_ADMIN=DSO::your-network-party
# NEXT_PUBLIC_CANTON_CC_REGISTRY_URL=https://your-public-registry.example
