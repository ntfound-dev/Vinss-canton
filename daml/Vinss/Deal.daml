module Vinss.Deal where

import DA.Text qualified as Text
import DA.TextMap qualified as TextMap
import Splice.Api.Token.MetadataV1 qualified as Meta
import Splice.Api.Token.HoldingV1 qualified as Holding
import Splice.Api.Token.AllocationV1 qualified as Allocation

-- Canton Coin (CC) escrow, via the Canton Network Token Standard (CIP-56).
--
-- VINSS never holds funds. The payer's own wallet locks CC into a standard
-- `Allocation` (Splice.Api.Token.AllocationV1) before fulfillment, and the
-- payee claims it after approval by exercising the standard's own
-- `Allocation_ExecuteTransfer` choice. VINSS's contracts only reference that
-- Allocation by ContractId and check it names the right deal, parties and
-- registry -- they never implement Holding or Allocation themselves, and
-- never move CC on their own authority alone.
--
-- Money flow: the reviewer (who approves the work) is the payer and the
-- fulfiller (who delivers it) is the payee. With the default roles this is
-- buyer -> seller, and it stays coherent when the roles are swapped (e.g.
-- freelance offers, where the seller delivers and the buyer reviews).
--
-- `instrumentAdmin` is the Party that administers the CC instrument (the
-- Amulet/CC registry's `admin` party -- differs between MainNet and any
-- TestNet/LocalNet). A deal without one keeps the original flow and has
-- nothing to settle on Canton.

usesEscrow : Optional Party -> Bool
usesEscrow instrumentAdmin =
  case instrumentAdmin of
    None -> False
    Some _ -> True

-- The registry admin is a network party, not a deal party.
instrumentAdminIsIndependent : Party -> Party -> Optional Party -> Bool
instrumentAdminIsIndependent seller buyer instrumentAdmin =
  case instrumentAdmin of
    None -> True
    Some admin -> admin /= seller && admin /= buyer


template DealProposal
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    termsHash : Text
    amount : Text
    instrumentId : Text
    expiresAt : Time
    createdAt : Time
    instrumentAdmin : Optional Party
  where
    signatory seller
    observer buyer

    ensure
      seller /= buyer
      &&
      fulfiller /= reviewer
      &&
      (fulfiller == seller || fulfiller == buyer)
      &&
      (reviewer == seller || reviewer == buyer)
      &&
      termsHash /= ""
      &&
      amount /= ""
      &&
      instrumentId /= ""
      &&
      expiresAt > createdAt
      &&
      instrumentAdminIsIndependent seller buyer instrumentAdmin

    choice Accept : ContractId DealAgreement
      controller buyer
      do
        now <- getTime

        assert (now <= expiresAt)

        create DealAgreement with
          dealId
          conversationId
          seller
          buyer
          fulfiller
          reviewer
          termsHash
          amount
          instrumentId
          expiresAt
          acceptedAt = now
          instrumentAdmin

    choice Reject : ()
      controller buyer
      do
        pure ()


template DealAgreement
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    termsHash : Text
    amount : Text
    instrumentId : Text
    expiresAt : Time
    acceptedAt : Time
    instrumentAdmin : Optional Party
  where
    signatory seller, buyer

    ensure
      seller /= buyer
      &&
      fulfiller /= reviewer
      &&
      (fulfiller == seller || fulfiller == buyer)
      &&
      (reviewer == seller || reviewer == buyer)
      &&
      termsHash /= ""
      &&
      amount /= ""
      &&
      instrumentId /= ""
      &&
      instrumentAdminIsIndependent seller buyer instrumentAdmin

    -- Original flow, kept for deals without escrow. Deals that name an
    -- instrumentAdmin must go through FundEscrow first.
    choice SubmitFulfillment : ContractId DealFulfillment
      with
        fulfillmentHash : Text
      controller fulfiller
      do
        assert (fulfillmentHash /= "")

        assertMsg
          "Fund the escrow before submitting fulfillment"
          (not (usesEscrow instrumentAdmin))

        now <- getTime

        create DealFulfillment with
          dealId
          conversationId
          seller
          buyer
          fulfiller
          reviewer
          termsHash
          amount
          instrumentId
          expiresAt
          acceptedAt
          fulfillmentHash
          round = 0
          submittedAt = now
          lockedAllocationCid = None

    -- The payer's wallet must already have locked CC into a standard
    -- Allocation (Splice AllocationFactory_Allocate, off-ledger, before this
    -- choice: see docs/ARCHITECTURE.md). This choice only references and
    -- validates that Allocation; VINSS never creates or holds it.
    choice FundEscrow : ContractId DealEscrow
      with
        allocationCid : ContractId Allocation.Allocation
      controller reviewer
      do
        case instrumentAdmin of
          None ->
            abort "This deal does not use Canton escrow"

          Some admin -> do
            allocation <- fetch allocationCid
            let allocView = view allocation
            let spec = allocView.allocation
            let leg = spec.transferLeg

            assertMsg
              "Allocation instrument admin must match the agreed registry"
              (leg.instrumentId.admin == admin)

            assertMsg
              "Allocation instrument id must match the deal instrument"
              (leg.instrumentId.id == instrumentId)

            case Text.parseDecimal amount of
              None ->
                abort "Deal amount must be a valid decimal"

              Some expectedAmount ->
                assertMsg
                  "Allocation amount must match the deal amount"
                  (leg.amount == expectedAmount)

            assertMsg
              "Allocation must be for this deal"
              (spec.settlement.settlementRef.id == dealId)

            assertMsg
              "Allocation sender must be the payer (reviewer)"
              (leg.sender == reviewer)

            assertMsg
              "Allocation receiver must be the payee (fulfiller)"
              (leg.receiver == fulfiller)

            assertMsg
              "Allocation executor must be the payee (fulfiller), who later claims settlement"
              (spec.settlement.executor == fulfiller)

            now <- getTime

            create DealEscrow with
              dealId
              conversationId
              seller
              buyer
              fulfiller
              reviewer
              instrumentAdmin = admin
              termsHash
              amount
              instrumentId
              expiresAt
              acceptedAt
              lockedAllocationCid = allocationCid
              fundedAt = now


-- Funded deal: the payer's CC is locked in the referenced Allocation and
-- cannot move without an approved fulfillment (see FulfillmentApproval.Settle).
template DealEscrow
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    instrumentAdmin : Party
    termsHash : Text
    amount : Text
    instrumentId : Text
    expiresAt : Time
    acceptedAt : Time
    lockedAllocationCid : ContractId Allocation.Allocation
    fundedAt : Time
  where
    signatory seller, buyer

    ensure
      seller /= buyer
      &&
      fulfiller /= reviewer
      &&
      (fulfiller == seller || fulfiller == buyer)
      &&
      (reviewer == seller || reviewer == buyer)
      &&
      termsHash /= ""
      &&
      amount /= ""
      &&
      instrumentId /= ""

    -- Named differently from DealAgreement.SubmitFulfillment because choice
    -- names are unique within a Daml module.
    choice SubmitFundedFulfillment : ContractId DealFulfillment
      with
        fulfillmentHash : Text
      controller fulfiller
      do
        assert (fulfillmentHash /= "")

        now <- getTime

        create DealFulfillment with
          dealId
          conversationId
          seller
          buyer
          fulfiller
          reviewer
          termsHash
          amount
          instrumentId
          expiresAt
          acceptedAt
          fulfillmentHash
          round = 0
          submittedAt = now
          lockedAllocationCid = Some lockedAllocationCid


template DealFulfillment
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    termsHash : Text
    amount : Text
    instrumentId : Text
    expiresAt : Time
    acceptedAt : Time
    fulfillmentHash : Text
    round : Int
    submittedAt : Time
    lockedAllocationCid : Optional (ContractId Allocation.Allocation)
  where
    signatory fulfiller
    observer reviewer

    ensure
      fulfiller /= reviewer
      &&
      fulfillmentHash /= ""
      &&
      round >= 0

    choice Approve : ContractId FulfillmentApproval
      controller reviewer
      do
        now <- getTime

        create FulfillmentApproval with
          dealId
          conversationId
          seller
          buyer
          fulfiller
          reviewer
          termsHash
          amount
          instrumentId
          fulfillmentHash
          round
          submittedAt
          approvedAt = now
          lockedAllocationCid

    choice RequestRevision : ContractId DealRevisionRequest
      with
        reviewHash : Text
      controller reviewer
      do
        assert (reviewHash /= "")

        now <- getTime

        create DealRevisionRequest with
          dealId
          conversationId
          seller
          buyer
          fulfiller
          reviewer
          termsHash
          amount
          instrumentId
          expiresAt
          acceptedAt
          previousFulfillmentHash = fulfillmentHash
          reviewHash
          round
          requestedAt = now
          lockedAllocationCid


template DealRevisionRequest
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    termsHash : Text
    amount : Text
    instrumentId : Text
    expiresAt : Time
    acceptedAt : Time
    previousFulfillmentHash : Text
    reviewHash : Text
    round : Int
    requestedAt : Time
    lockedAllocationCid : Optional (ContractId Allocation.Allocation)
  where
    signatory reviewer
    observer fulfiller

    ensure
      fulfiller /= reviewer
      &&
      previousFulfillmentHash /= ""
      &&
      reviewHash /= ""
      &&
      round >= 0

    choice SubmitRevision : ContractId DealFulfillment
      with
        fulfillmentHash : Text
      controller fulfiller
      do
        assert (fulfillmentHash /= "")

        now <- getTime

        create DealFulfillment with
          dealId
          conversationId
          seller
          buyer
          fulfiller
          reviewer
          termsHash
          amount
          instrumentId
          expiresAt
          acceptedAt
          fulfillmentHash
          round = round + 1
          submittedAt = now
          lockedAllocationCid


template FulfillmentApproval
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    termsHash : Text
    amount : Text
    instrumentId : Text
    fulfillmentHash : Text
    round : Int
    submittedAt : Time
    approvedAt : Time
    lockedAllocationCid : Optional (ContractId Allocation.Allocation)
  where
    signatory reviewer
    observer fulfiller

    ensure
      fulfiller /= reviewer
      &&
      fulfillmentHash /= ""
      &&
      round >= 0

    -- The payee claims the escrowed CC after approval, by exercising the
    -- Token Standard's own Allocation_ExecuteTransfer -- not VINSS code.
    -- `extraArgs` (the off-ledger choice context) must come from the CC
    -- registry's API; the caller is responsible for fetching it.
    --
    -- Authorization: Allocation_ExecuteTransfer needs sender (reviewer),
    -- receiver (fulfiller) and executor (fulfiller, see FundEscrow). The
    -- fulfiller supplies their own as controller here; the reviewer's was
    -- already given when they signed this FulfillmentApproval, so CC can
    -- only move through an approved fulfillment.
    choice Settle : ContractId SettlementReceipt
      with
        extraArgs : Meta.ExtraArgs
      controller fulfiller
      do
        case lockedAllocationCid of
          None ->
            abort "This deal has no Canton escrow to settle"

          Some allocCid -> do
            result <-
              exercise allocCid Allocation.Allocation_ExecuteTransfer with
                extraArgs

            now <- getTime

            create SettlementReceipt with
              dealId
              conversationId
              seller
              buyer
              fulfiller
              reviewer
              amount
              instrumentId
              fulfillmentHash
              round
              receiverHoldingCids = result.receiverHoldingCids
              settledAt = now


template SettlementReceipt
  with
    dealId : Text
    conversationId : Text
    seller : Party
    buyer : Party
    fulfiller : Party
    reviewer : Party
    amount : Text
    instrumentId : Text
    fulfillmentHash : Text
    round : Int
    receiverHoldingCids : [ContractId Holding.Holding]
    settledAt : Time
  where
    signatory fulfiller, reviewer

    ensure
      fulfiller /= reviewer
      &&
      fulfillmentHash /= ""
      &&
      round >= 0
