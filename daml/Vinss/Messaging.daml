module Vinss.Messaging where

template EncryptedChannel
  with
    channelId : Text
    owner : Party
    members : [Party]
  where
    signatory owner
    observer members

    ensure owner `elem` members

    choice AddMember : ContractId EncryptedChannel
      with
        member : Party
      controller owner
      do
        assert (not (member `elem` members))

        create this with
          members = member :: members

    choice RemoveMember : ContractId EncryptedChannel
      with
        member : Party
      controller owner
      do
        assert (member /= owner)
        assert (member `elem` members)

        create this with
          members =
            filter
              (\candidate ->
                candidate /= member
              )
              members


template MlsDelivery
  with
    deliveryId : Text
    channelId : Text
    sender : Party
    recipient : Party
    senderInstallationId : Text
    recipientInstallationId : Text
    kind : Text
    payloadB64 : Text
    createdAt : Time
  where
    signatory sender
    observer recipient

    ensure
      sender /= recipient
      &&
      senderInstallationId /= recipientInstallationId
      &&
      (
        kind == "welcome"
        ||
        kind == "commit"
      )


template EncryptedMessage
  with
    messageId : Text
    channelId : Text
    sender : Party
    senderInstallationId : Text
    recipients : [Party]
    epoch : Int
    ciphertextB64 : Text
    createdAt : Time
  where
    signatory sender
    observer recipients

    ensure
      not (sender `elem` recipients)


template KeyPackageRequest
  with
    requestId : Text
    requester : Party
    recipient : Party
    installationId : Text
  where
    signatory requester
    observer recipient

    ensure requester /= recipient

    nonconsuming choice ProvideKeyPackage
      : ContractId KeyPackageOffer
      with
        packageId : Text
        keyPackageB64 : Text
        createdAt : Time
        expiresAt : Time
      controller recipient
      do
        create KeyPackageOffer with
          packageId
          requestId
          owner = recipient
          requester
          installationId
          keyPackageB64
          createdAt
          expiresAt


template KeyPackageOffer
  with
    packageId : Text
    requestId : Text
    owner : Party
    requester : Party
    installationId : Text
    keyPackageB64 : Text
    createdAt : Time
    expiresAt : Time
  where
    signatory owner
    observer requester

    ensure owner /= requester
