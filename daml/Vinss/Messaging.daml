module Vinss.Messaging where

-- Canton stores only encrypted/opaque messaging material.
-- Room title, roles, deal text, and plaintext messages belong inside MLS.

template EncryptedChannel
  with
    channelId : Text
    owner : Party
    members : [Party]
  where
    signatory owner
    observer members

    ensure owner `elem` members

    choice AddMember : ContractId EncryptedChannel
      with
        member : Party
      controller owner
      do
        assert (not (member `elem` members))

        create this with
          members = member :: members

    choice RemoveMember : ContractId EncryptedChannel
      with
        member : Party
      controller owner
      do
        assert (member /= owner)
        assert (member `elem` members)

        create this with
          members =
            filter
              (\candidate ->
                candidate /= member
              )
              members


-- MLS Welcome and Commit delivery.
--
-- The payload is serialized MLS bytes encoded for Ledger API transport.
-- Canton can see the involved Canton parties because this is not an
-- anonymity pool; it cannot read the MLS cryptographic payload itself.
template MlsDelivery
  with
    deliveryId : Text
    channelId : Text
    sender : Party
    recipient : Party
    kind : Text
    payloadB64 : Text
    createdAt : Time
  where
    signatory sender
    observer recipient

    ensure
      sender /= recipient
      &&
      (
        kind == "welcome"
        ||
        kind == "commit"
      )


-- MLS encrypted application payload.
--
-- ciphertextB64 may contain:
-- - chat messages
-- - encrypted group state
-- - replies/reactions
-- - deal application messages
--
-- Canton never receives those values in plaintext.
template EncryptedMessage
  with
    messageId : Text
    channelId : Text
    sender : Party
    recipients : [Party]
    epoch : Int
    ciphertextB64 : Text
    createdAt : Time
  where
    signatory sender
    observer recipients

    ensure
      not (sender `elem` recipients)


-- Pairwise KeyPackage request.
--
-- This avoids requiring a global trusted KeyPackage directory.
-- The requester and requested party are the only Canton parties
-- who need to see this request.
template KeyPackageRequest
  with
    requestId : Text
    requester : Party
    recipient : Party
    installationId : Text
  where
    signatory requester
    observer recipient

    ensure requester /= recipient

    nonconsuming choice ProvideKeyPackage
      : ContractId KeyPackageOffer
      with
        packageId : Text
        keyPackageB64 : Text
        expiresAt : Time
      controller recipient
      do
        create KeyPackageOffer with
          packageId
          requestId
          owner = recipient
          requester
          installationId
          keyPackageB64
          expiresAt


-- KeyPackage is visible only to its owner and requester.
template KeyPackageOffer
  with
    packageId : Text
    requestId : Text
    owner : Party
    requester : Party
    installationId : Text
    keyPackageB64 : Text
    expiresAt : Time
  where
    signatory owner
    observer requester

    ensure owner /= requester
